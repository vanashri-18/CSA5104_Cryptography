#include <stdio.h>
#include <string.h>
#include <ctype.h>

void encrypt(char text[], int key) {
    int i;
    for(i = 0; text[i] != '\0'; i++) {
        if(isupper(text[i])) {
            text[i] = ((text[i] - 'A' + key) % 26) + 'A';
        }
        else if(islower(text[i])) {
            text[i] = ((text[i] - 'a' + key) % 26) + 'a';
        }
    }
}

void decrypt(char text[], int key) {
    int i;
    for(i = 0; text[i] != '\0'; i++) {
        if(isupper(text[i])) {
            text[i] = ((text[i] - 'A' - key + 26) % 26) + 'A';
        }
        else if(islower(text[i])) {
            text[i] = ((text[i] - 'a' - key + 26) % 26) + 'a';
        }
    }
}

void bruteForce(char cipher[]) {
    char temp[100];
    int key, i;

    printf("\nBrute Force Attack Results:\n");

    for(key = 1; key <= 25; key++) {
        strcpy(temp, cipher);

        for(i = 0; temp[i] != '\0'; i++) {
            if(isupper(temp[i])) {
                temp[i] = ((temp[i] - 'A' - key + 26) % 26) + 'A';
            }
            else if(islower(temp[i])) {
                temp[i] = ((temp[i] - 'a' - key + 26) % 26) + 'a';
            }
        }

        printf("Key %2d : %s\n", key, temp);
    }
}

int main() {
    char plaintext[100], ciphertext[100], decrypted[100];
    int key, choice;

    printf("Enter Plaintext: ");
    fgets(plaintext, sizeof(plaintext), stdin);

    plaintext[strcspn(plaintext, "\n")] = '\0';

    printf("Enter Key (1-25): ");
    scanf("%d", &key);

    strcpy(ciphertext, plaintext);
    encrypt(ciphertext, key);

    printf("\nEncrypted Text : %s\n", ciphertext);

    strcpy(decrypted, ciphertext);
    decrypt(decrypted, key);

    printf("Decrypted Text : %s\n", decrypted);

    printf("\nDo you want to perform Brute Force Attack?\n");
    printf("1. Yes\n");
    printf("2. No\n");
    printf("Enter choice: ");
    scanf("%d", &choice);

    if(choice == 1) {
        bruteForce(ciphertext);
    }

    return 0;
}
