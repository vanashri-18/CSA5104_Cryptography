#include <stdio.h>
#include <string.h>
#include <ctype.h>
#include <time.h>

#define MAX 500

char monoKey[] = "QWERTYUIOPASDFGHJKLZXCVBNM";

//-------------------------------------
// Frequency Analysis
//-------------------------------------
void frequency(char text[])
{
    int count[26]={0};
    int i;

    for(i=0;text[i]!='\0';i++)
    {
        if(isalpha(text[i]))
            count[toupper(text[i])-'A']++;
    }

    printf("\nFrequency Distribution:\n");

    for(i=0;i<26;i++)
        printf("%c:%d ",i+'A',count[i]);

    printf("\n");
}

//-------------------------------------
// Repeated Letters
//-------------------------------------
void repeatedLetters(char text[])
{
    int i;

    printf("\nRepeated Letters: ");

    for(i=0;text[i+1]!='\0';i++)
    {
        if(text[i]==text[i+1])
            printf("%c ",text[i]);
    }

    printf("\n");
}

//-------------------------------------
// Caesar Cipher
//-------------------------------------
void caesarEncrypt(char plain[],char cipher[],int key)
{
    int i;

    for(i=0;plain[i]!='\0';i++)
    {
        if(isalpha(plain[i]))
            cipher[i]=((toupper(plain[i])-'A'+key)%26)+'A';
        else
            cipher[i]=plain[i];
    }

    cipher[i]='\0';
}

//-------------------------------------
// Monoalphabetic Cipher
//-------------------------------------
void monoEncrypt(char plain[],char cipher[])
{
    int i;

    for(i=0;plain[i]!='\0';i++)
    {
        if(isalpha(plain[i]))
            cipher[i]=monoKey[toupper(plain[i])-'A'];
        else
            cipher[i]=plain[i];
    }

    cipher[i]='\0';
}

//-------------------------------------
// Vigenere Cipher
//-------------------------------------
void vigenereEncrypt(char plain[], char key[], char cipher[])
{
    int i, j = 0;
    int keyLen = strlen(key);

    for(i = 0; plain[i] != '\0'; i++)
    {
        if(isalpha(plain[i]))
        {
            cipher[i] = ((toupper(plain[i]) - 'A') +
                         (toupper(key[j % keyLen]) - 'A')) % 26 + 'A';
            j++;
        }
        else
            cipher[i] = plain[i];
    }

    cipher[i] = '\0';
}

//-------------------------------------
// GCD Function
//-------------------------------------
int gcd(int a, int b)
{
    while(b != 0)
    {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}

//-------------------------------------
// Modular Inverse
//-------------------------------------
int modInverse(int det)
{
    det = (det % 26 + 26) % 26;

    for(int i = 1; i < 26; i++)
    {
        if((det * i) % 26 == 1)
            return i;
    }

    return -1;
}

//-------------------------------------
// Hill Cipher Encryption (2x2)
//-------------------------------------
void hillEncrypt(char plain[], char cipher[], int key[2][2])
{
    int len = strlen(plain);

    for(int i = 0; i < len; i++)
        plain[i] = toupper(plain[i]);

    if(len % 2 != 0)
    {
        plain[len] = 'X';
        plain[len + 1] = '\0';
        len++;
    }

    for(int i = 0; i < len; i += 2)
    {
        int p1 = plain[i] - 'A';
        int p2 = plain[i + 1] - 'A';

        cipher[i] =
            ((key[0][0] * p1 + key[0][1] * p2) % 26) + 'A';

        cipher[i + 1] =
            ((key[1][0] * p1 + key[1][1] * p2) % 26) + 'A';
    }

    cipher[len] = '\0';
}

//-------------------------------------
// Hill Cipher Decryption
//-------------------------------------
void hillDecrypt(char cipher[], char plain[], int key[2][2])
{
    int det =
        key[0][0] * key[1][1] -
        key[0][1] * key[1][0];

    det = (det % 26 + 26) % 26;

    int detInv = modInverse(det);

    if(detInv == -1)
    {
        printf("\nInvalid Hill Key Matrix!\n");
        return;
    }

    int inv[2][2];

    inv[0][0] = ( key[1][1] * detInv) % 26;
    inv[0][1] = (-key[0][1] * detInv) % 26;
    inv[1][0] = (-key[1][0] * detInv) % 26;
    inv[1][1] = ( key[0][0] * detInv) % 26;

    for(int i = 0; i < 2; i++)
        for(int j = 0; j < 2; j++)
            inv[i][j] = (inv[i][j] + 26) % 26;

    int len = strlen(cipher);

    for(int i = 0; i < len; i += 2)
    {
        int c1 = cipher[i] - 'A';
        int c2 = cipher[i + 1] - 'A';

        plain[i] =
            ((inv[0][0] * c1 +
              inv[0][1] * c2) % 26) + 'A';

        plain[i + 1] =
            ((inv[1][0] * c1 +
              inv[1][1] * c2) % 26) + 'A';
    }

    plain[len] = '\0';
}

int main()
{
    char plaintext[MAX];
    char caesar[MAX], mono[MAX], vig[MAX], hill[MAX];
    char keyword[50];

    int hillKey[2][2];

    clock_t start, end;
    double t1, t2, t3, t4;

    printf("=========== Comparative Security Analysis ===========\n");

    printf("\nEnter Plaintext : ");
    fgets(plaintext, MAX, stdin);
    plaintext[strcspn(plaintext, "\n")] = '\0';

    printf("Enter Vigenere Keyword : ");
    scanf("%s", keyword);

    printf("\nEnter Hill Cipher 2x2 Key Matrix:\n");
    printf("a b\nc d\n");

    scanf("%d%d", &hillKey[0][0], &hillKey[0][1]);
    scanf("%d%d", &hillKey[1][0], &hillKey[1][1]);

    // Check Hill Key Validity
    int det = hillKey[0][0] * hillKey[1][1] -
              hillKey[0][1] * hillKey[1][0];

    det = (det % 26 + 26) % 26;

    if(gcd(det,26)!=1)
    {
        printf("\nInvalid Hill Cipher Key Matrix.\n");
        printf("Determinant is not relatively prime to 26.\n");
        return 0;
    }

    // Caesar
    start = clock();
    caesarEncrypt(plaintext, caesar, 3);
    end = clock();
    t1 = (double)(end-start)/CLOCKS_PER_SEC;

    // Monoalphabetic
    start = clock();
    monoEncrypt(plaintext, mono);
    end = clock();
    t2 = (double)(end-start)/CLOCKS_PER_SEC;

    // Vigenere
    start = clock();
    vigenereEncrypt(plaintext, keyword, vig);
    end = clock();
    t3 = (double)(end-start)/CLOCKS_PER_SEC;

    // Hill
    start = clock();
    hillEncrypt(plaintext, hill, hillKey);
    end = clock();
    t4 = (double)(end-start)/CLOCKS_PER_SEC;

    printf("\n================ Ciphertexts ================\n");

    printf("\nCaesar Cipher        : %s\n", caesar);

    printf("Monoalphabetic Cipher: %s\n", mono);

    printf("Vigenere Cipher      : %s\n", vig);

    printf("Hill Cipher          : %s\n", hill);

    printf("\n============= Frequency Analysis =============");

    printf("\n\nCaesar Cipher");
    frequency(caesar);

    printf("\nMonoalphabetic Cipher");
    frequency(mono);

    printf("\nVigenere Cipher");
    frequency(vig);

    printf("\nHill Cipher");
    frequency(hill);

    printf("\n============= Repeated Letters =============");

    printf("\nCaesar Cipher");
    repeatedLetters(caesar);

    printf("\nMonoalphabetic Cipher");
    repeatedLetters(mono);

    printf("\nVigenere Cipher");
    repeatedLetters(vig);

    printf("\nHill Cipher");
    repeatedLetters(hill);

    printf("\n\n================ Comparative Results =====================\n");

    printf("+----------------------+----------------------+----------------+\n");
    printf("| Cipher               | Ciphertext Length    | Time (seconds) |\n");
    printf("+----------------------+----------------------+----------------+\n");

    printf("| Caesar               | %-20lu | %-14f |\n",
           strlen(caesar), t1);

    printf("| Monoalphabetic       | %-20lu | %-14f |\n",
           strlen(mono), t2);

    printf("| Vigenere             | %-20lu | %-14f |\n",
           strlen(vig), t3);

    printf("| Hill                 | %-20lu | %-14f |\n",
           strlen(hill), t4);

    printf("+----------------------+----------------------+----------------+\n");

    printf("\nPattern Analysis:\n");
    printf("1. Caesar Cipher preserves repeated-letter patterns because every letter is shifted by the same amount.\n");
    printf("2. Monoalphabetic Cipher replaces each letter consistently, so repeated letters remain repeated.\n");
    printf("3. Vigenere Cipher uses a repeating keyword, reducing obvious patterns compared to Caesar and Monoalphabetic.\n");
    printf("4. Hill Cipher encrypts pairs of letters using matrix multiplication, significantly reducing visible patterns.\n");

    printf("\nSecurity Ranking:\n");
    printf("Hill Cipher > Vigenere Cipher > Monoalphabetic Cipher > Caesar Cipher\n");

    return 0;
}
