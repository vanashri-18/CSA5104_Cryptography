#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include <time.h>

char key[26];

// Function to generate random substitution key
void generateKey() {
    int i, j;
    char alphabet[26];

    for(i = 0; i < 26; i++)
        alphabet[i] = 'A' + i;

    srand(time(NULL));

    for(i = 25; i > 0; i--) {
        j = rand() % (i + 1);
        char temp = alphabet[i];
        alphabet[i] = alphabet[j];
        alphabet[j] = temp;
    }

    for(i = 0; i < 26; i++)
        key[i] = alphabet[i];
}

// Function to encrypt text
void encrypt(char text[], char cipher[]) {
    int i;

    for(i = 0; text[i] != '\0'; i++) {
        if(isupper(text[i])) {
            cipher[i] = key[text[i] - 'A'];
        }
        else if(islower(text[i])) {
            cipher[i] = tolower(key[text[i] - 'a']);
        }
        else {
            cipher[i] = text[i];
        }
    }
    cipher[i] = '\0';
}

// Frequency Analysis
void frequencyAnalysis(char cipher[]) {
    int freq[26] = {0};
    int i, j;

    for(i = 0; cipher[i] != '\0'; i++) {
        if(isalpha(cipher[i])) {
            freq[toupper(cipher[i]) - 'A']++;
        }
    }

    printf("\nLetter Frequencies:\n");
    for(i = 0; i < 26; i++) {
        printf("%c : %d\n", 'A' + i, freq[i]);
    }

    printf("\nTop 3 Most Frequent Letters:\n");

    for(i = 0; i < 3; i++) {
        int max = -1;
        int index = -1;

        for(j = 0; j < 26; j++) {
            if(freq[j] > max) {
                max = freq[j];
                index = j;
            }
        }

        if(index != -1) {
            printf("%d. %c -> %d times\n", i + 1, 'A' + index, max);
            freq[index] = -1;
        }
    }
}

int main() {
    char plaintext[500];
    char ciphertext[500];

    printf("Enter a paragraph:\n");
    fgets(plaintext, sizeof(plaintext), stdin);

    generateKey();

    printf("\nRandom Substitution Key:\n");
    for(int i = 0; i < 26; i++)
        printf("%c ", key[i]);

    printf("\n");

    encrypt(plaintext, ciphertext);

    printf("\nEncrypted Text:\n%s\n", ciphertext);

    frequencyAnalysis(ciphertext);

    return 0;
}
