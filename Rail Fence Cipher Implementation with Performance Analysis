#include <stdio.h>
#include <string.h>
#include <time.h>

#define MAX 1000

// Display Rail Matrix
void displayMatrix(char rail[20][MAX], int rails, int len)
{
    printf("\nRail Matrix:\n");

    for(int i=0;i<rails;i++)
    {
        for(int j=0;j<len;j++)
        {
            if(rail[i][j]=='\0')
                printf("  ");
            else
                printf("%c ",rail[i][j]);
        }
        printf("\n");
    }
}

// Encryption
void encrypt(char text[], int rails, char cipher[])
{
    char rail[20][MAX] = {{0}};

    int len = strlen(text);

    int row = 0;
    int dir = 1;

    for(int i=0;i<len;i++)
    {
        rail[row][i] = text[i];

        if(row==0)
            dir=1;
        else if(row==rails-1)
            dir=-1;

        row += dir;
    }

    displayMatrix(rail, rails, len);

    int index=0;

    for(int i=0;i<rails;i++)
        for(int j=0;j<len;j++)
            if(rail[i][j]!=0)
                cipher[index++]=rail[i][j];

    cipher[index]='\0';
}

// Decryption
void decrypt(char cipher[], int rails, char plain[])
{
    int len=strlen(cipher);

    char rail[20][MAX]={{0}};

    int row=0;
    int dir=1;

    // Mark positions
    for(int i=0;i<len;i++)
    {
        rail[row][i]='*';

        if(row==0)
            dir=1;
        else if(row==rails-1)
            dir=-1;

        row+=dir;
    }

    // Fill Ciphertext
    int index=0;

    for(int i=0;i<rails;i++)
        for(int j=0;j<len;j++)
            if(rail[i][j]=='*')
                rail[i][j]=cipher[index++];

    // Read Zigzag
    row=0;
    dir=1;

    index=0;

    for(int i=0;i<len;i++)
    {
        plain[index++]=rail[row][i];

        if(row==0)
            dir=1;
        else if(row==rails-1)
            dir=-1;

        row+=dir;
    }

    plain[index]='\0';
}

int main()
{
    char plaintext[MAX];
    char ciphertext[MAX];
    char decrypted[MAX];

    int rails;

    clock_t start,end;

    printf("========== Rail Fence Cipher ==========\n");

    printf("\nEnter Plaintext : ");
    fgets(plaintext,MAX,stdin);

    plaintext[strcspn(plaintext,"\n")]=0;

    printf("Enter Number of Rails (2-10): ");
    scanf("%d",&rails);

    if(rails<2 || rails>10)
    {
        printf("Invalid Number of Rails.\n");
        return 0;
    }

    start=clock();

    encrypt(plaintext,rails,ciphertext);

    end=clock();

    double encTime=(double)(end-start)/CLOCKS_PER_SEC;

    start=clock();

    decrypt(ciphertext,rails,decrypted);

    end=clock();

    double decTime=(double)(end-start)/CLOCKS_PER_SEC;

    printf("\nCiphertext : %s\n",ciphertext);

    printf("Decrypted Text : %s\n",decrypted);

    printf("\nExecution Time\n");
    printf("Encryption : %.8f seconds\n",encTime);
    printf("Decryption : %.8f seconds\n",decTime);

    printf("\nPerformance Analysis\n");
    printf("---------------------------\n");
    printf("Encryption Time Complexity : O(n)\n");
    printf("Decryption Time Complexity : O(n)\n");
    printf("Space Complexity           : O(r × n)\n");

    printf("\nObservation:\n");
    printf("As the number of rails increases (2-10), the zigzag pattern changes,\n");
    printf("producing different ciphertext structures while maintaining linear\n");
    printf("time complexity.\n");

    return 0;
}
