#include <stdio.h>
#include <string.h>

int main()
{
    char role[20];

    printf("Enter Role: ");
    scanf("%s", role);

    if(strcmp(role, "Admin") == 0 || strcmp(role, "admin") == 0)
    {
        printf("\nPermissions:\n");
        printf("Read\n");
        printf("Write\n");
        printf("Delete\n");
    }
    else if(strcmp(role, "Faculty") == 0 || strcmp(role, "faculty") == 0)
    {
        printf("\nPermissions:\n");
        printf("Read\n");
        printf("Write\n");
    }
    else if(strcmp(role, "Student") == 0 || strcmp(role, "student") == 0)
    {
        printf("\nPermissions:\n");
        printf("Read Only\n");
    }
    else
    {
        printf("\nInvalid Role\n");
    }

    return 0;
}
