#include <stdio.h>
#include <string.h>

// Function to assign security level
int getLevel(char level[])
{
    if(strcmp(level, "Public") == 0)
        return 1;
    else if(strcmp(level, "Confidential") == 0)
        return 2;
    else if(strcmp(level, "Secret") == 0)
        return 3;
    else if(strcmp(level, "TopSecret") == 0 || strcmp(level, "Top_Secret") == 0)
        return 4;
    else
        return -1;
}

int main()
{
    char userLevel[20], fileLevel[20], operation[10];

    printf("Security Levels:\n");
    printf("Public\nConfidential\nSecret\nTopSecret\n\n");

    printf("Enter User Level : ");
    scanf("%s", userLevel);

    printf("Enter File Level : ");
    scanf("%s", fileLevel);

    printf("Enter Operation (Read/Write): ");
    scanf("%s", operation);

    int user = getLevel(userLevel);
    int file = getLevel(fileLevel);

    if(user == -1 || file == -1)
    {
        printf("\nInvalid Security Level\n");
        return 0;
    }

    if(strcmp(operation, "Read") == 0 || strcmp(operation, "read") == 0)
    {
        // No Read Up
        if(user >= file)
        {
            printf("\nAccess Allowed\n");
        }
        else
        {
            printf("\nAccess Denied\n");
            printf("Reason : No Read Up\n");
        }
    }
    else if(strcmp(operation, "Write") == 0 || strcmp(operation, "write") == 0)
    {
        // No Write Down
        if(user <= file)
        {
            printf("\nAccess Allowed\n");
        }
        else
        {
            printf("\nAccess Denied\n");
            printf("Reason : No Write Down\n");
        }
    }
    else
    {
        printf("\nInvalid Operation\n");
    }

    return 0;
}
